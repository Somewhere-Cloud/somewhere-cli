# npm's default fetch-timeout is 300000 ms, so a stalled registry request can
# wait five minutes before npm retries it. On 2026-10-22 cli-checks spent 421 s
# in npm ci and 423 s in one npx-backed test (both 3-4 s on earlier runs) and
# hit its 20-minute limit (tsk_da2dba3d). A 60 s timeout with more retries
# bounds each stall. npm reads this for npm ci, and `npm test` passes it to the
# npm/npx children the tests start in other directories as npm_config_*.
fetch-timeout=60000
fetch-retries=4
