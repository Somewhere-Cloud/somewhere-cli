{
  "name": "@somewhere-cloud/cli",
  "version": "0.38.145",
  "description": "CLI for somewhere.cloud — auth, projects, deploy, pull, promote, db, logs, env, MCP bridge.",
  "keywords": [
    "somewhere",
    "somewhere.cloud",
    "cli",
    "deploy",
    "mcp"
  ],
  "homepage": "https://somewhere.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Somewhere-Cloud/somewhere-cli.git"
  },
  "license": "MIT",
  "author": {
    "name": "somewhere.cloud",
    "email": "support@somewhere.cloud"
  },
  "type": "module",
  "bin": {
    "somewhere": "bin/somewhere.js",
    "sw": "bin/somewhere.js"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.third-party.txt",
    "README.md",
    "bin",
    "dist/commands/docs.js",
    "dist/commands/init.js",
    "dist/index.js",
    "dist/lib/bundle.js",
    "dist/lib/bundle.js.map",
    "dist/lib/declared-data.js",
    "dist/lib/files.js",
    "dist/lib/init-feature-template.js",
    "dist/lib/init-features.js",
    "dist/lib/skills-pack.generated.js",
    "dist/lib/source-lint.js",
    "dist/lib/test-reporter.js",
    "dist/lib/typecheck.js",
    "dist/script.js",
    "dist/testing.js",
    "dist/types",
    "npm-shrinkwrap.json",
    "runtime",
    "src/testing.ts"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-bundle.mjs",
    "dev": "tsc --watch",
    "prepublishOnly": "node -e \"console.error('Use the CLI publish workflow to publish the staged runtime tarball.'); process.exit(1)\"",
    "test": "npm run check:credentials && node scripts/test-isolated.mjs",
    "test:roundtrip": "node scripts/e2e-roundtrip.mjs",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check:credentials": "node scripts/check-credentials.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.19.21",
    "@types/prompts": "^2.4.0",
    "@types/semver": "^7.5.8",
    "chokidar": "^4.0.3",
    "commander": "^12.0.0",
    "esbuild": "0.25.12",
    "prompts": "^2.4.2",
    "semver": "^7.6.3",
    "sigstore": "4.1.1",
    "tar": "7.5.23",
    "typescript": "^5.4.0",
    "undici": "^8.4.1"
  },
  "exports": {
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json",
    "./script": {
      "types": "./dist/types/script.d.ts",
      "default": "./dist/script.js"
    }
  },
  "bundleDependencies": [],
  "bundledDependencies": []
}
